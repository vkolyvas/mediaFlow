# Postiz self-host configuration.
# Copy to .env in this directory and fill in. Never commit .env.

# --- Public address of the Postiz instance ---------------------------------
# On a public host, set this to the domain you will reach Postiz on and put a
# TLS-terminating reverse proxy in front of the port.
POSTIZ_PORT=4007
MAIN_URL=http://localhost:4007
FRONTEND_URL=http://localhost:4007
NEXT_PUBLIC_BACKEND_URL=http://localhost:4007/api

# --- Secrets ----------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-openssl-rand-base64-48

POSTGRES_USER=postiz-user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postiz-db-local

# --- Storage ----------------------------------------------------------------
# 'local' keeps uploads in the postiz-uploads volume. 'cloudflare' uses R2,
# which is what we want in production: the URLs must be publicly reachable by
# Instagram and Facebook at publish time.
STORAGE_PROVIDER=local
# Set to 'true' once the first admin account exists, so nobody else can
# register. Leave it 'false' until then - there is no other way in.
DISABLE_REGISTRATION=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKETNAME=
CLOUDFLARE_BUCKET_URL=
CLOUDFLARE_REGION=auto

# --- Social credentials -----------------------------------------------------
# Only the providers we actually publish to are needed.
# See README.md for how to obtain these.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Marketing engine -------------------------------------------------------
# The key the marketing engine uses for the Postiz public API.
# Create it in Postiz under Settings -> Public API.
POSTIZ_API_KEY=
