# Postiz self-host configuration.
# Copy to .env in this directory and fill in. Never commit .env.

# --- Public address of the Postiz instance ---------------------------------
# On a public host, set this to the domain you will reach Postiz on and put a
# TLS-terminating reverse proxy in front of the port.
#
# In production that reverse proxy is the Cloudflare Tunnel: postiz.weddingwise.gr
# is served by the connector that also serves the app, and the ingress rule
# lives in /etc/cloudflared/config.yml. Meta's OAuth redirect will not accept
# http://localhost, so the public hostname is not optional.
POSTIZ_PORT=4007
MAIN_URL=https://postiz.weddingwise.gr
FRONTEND_URL=https://postiz.weddingwise.gr
NEXT_PUBLIC_BACKEND_URL=https://postiz.weddingwise.gr/api

# --- Secrets ----------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-openssl-rand-base64-48

POSTGRES_USER=postiz-user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postiz-db-local

# --- Storage ----------------------------------------------------------------
# 'local' keeps uploads in the postiz-uploads volume. 'cloudflare' uses R2,
# which is what we want in production: the URLs must be publicly reachable by
# Instagram and Facebook at publish time. Postiz builds every media URL as
# CLOUDFLARE_BUCKET_URL + '/' + <object name>, so the bucket has to be
# publicly readable for Meta to fetch the media.
#
# The access key must be an R2 API token scoped to this one bucket with
# Object Read & Write. A token scoped to another bucket gets 403.
STORAGE_PROVIDER=local
# Set to 'true' once the first admin account exists, so nobody else can
# register. Leave it 'false' until then - there is no other way in.
DISABLE_REGISTRATION=false
CLOUDFLARE_ACCOUNT_ID=956a6b87172c9dc5896c21d27b825081
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKETNAME=socials
# The bucket's public base URL - the r2.dev dev URL, or a custom domain.
CLOUDFLARE_BUCKET_URL=
CLOUDFLARE_REGION=auto

# --- Social credentials -----------------------------------------------------
# Only the providers we actually publish to are needed.
# See README.md for how to obtain these.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Marketing engine -------------------------------------------------------
# The key the marketing engine uses for the Postiz public API.
# Create it in Postiz under Settings -> Public API.
POSTIZ_API_KEY=
