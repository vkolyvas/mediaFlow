# ---------------------------------------------------------------------------
# WeddingWise marketing engine - environment
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- WeddingWise application (read-only data source) -----------------------
# Base URL of the WeddingWise backend API (no /api/v1 suffix - the client
# appends it). Use the production host for real content, or
# http://localhost:9000 for local development.
WW_API_BASE_URL=https://api.weddingwise.gr
# Optional bearer token. Only needed for endpoints that are not public.
WW_API_TOKEN=
# Bearer token for the app's read-only internal marketing endpoint
# (GET /api/v1/internal/marketing/conversions). Required by `npm run
# collect-conversions` - without it, registrations cannot be attributed and
# the weekly report can only rank reach.
WW_INTERNAL_TOKEN=

# Public site origin, used to build landing-page URLs that we link to.
WW_SITE_URL=https://weddingwise.gr

# --- LLM (caption + script generation) -------------------------------------
ANTHROPIC_API_KEY=
DEFAULT_MODEL=claude-sonnet-4-20250514
MAX_TOKENS_PER_CALL=4000
# The API base. Anthropic's own by default. A gateway that speaks the same
# Messages API works the same way - MiniMax's Anthropic-compatible endpoint is
# https://api.minimax.io/anthropic with DEFAULT_MODEL=MiniMax-M2.7.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Postiz (self-hosted) ---------------------------------------------------
# Base URL of the Postiz backend API. For the bundled docker-compose this is
# http://localhost:4007/api - the CLI appends /public/v1/<endpoint>.
POSTIZ_API_URL=http://localhost:4007/api
# API key created in Postiz under Settings -> API Keys.
POSTIZ_API_KEY=
# Integration IDs to publish to. `postiz integrations:list` prints them.
# Leave empty to resolve them automatically at schedule time by identifier.
POSTIZ_INSTAGRAM_ID=
POSTIZ_FACEBOOK_ID=

# --- Storage for rendered media (optional) ---------------------------------
# Directory rendered media is written to before being uploaded to Postiz.
MARKETING_ASSETS_DIR=./assets/generated

# --- Campaign defaults ------------------------------------------------------
# UTM medium used for every link we publish.
UTM_MEDIUM=social
# Public base for short links / reporting.
MARKETING_PUBLIC_URL=https://weddingwise.gr
