{
  "name": "weddingwise-marketing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WeddingWise.gr social media acquisition engine",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "calendar": "node --env-file-if-exists=.env automation/build-calendar.mjs",
    "generate": "node --env-file-if-exists=.env automation/generate-content.mjs",
    "validate": "node --env-file-if-exists=.env automation/validate-content.mjs",
    "approve": "node --env-file-if-exists=.env automation/approve-content.mjs",
    "reject": "node --env-file-if-exists=.env automation/approve-content.mjs --reject",
    "schedule": "node --env-file-if-exists=.env automation/schedule-content.mjs",
    "collect": "node --env-file-if-exists=.env automation/collect-analytics.mjs",
    "report": "node --env-file-if-exists=.env automation/report.mjs",
    "status": "node --env-file-if-exists=.env automation/status.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs"
  },
  "dependencies": {
    "postiz": "^2.0.27"
  }
}
